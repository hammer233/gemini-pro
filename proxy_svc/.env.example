# 后端模式：browser（真实浏览器） / mock（本地模拟，不出网，用于压测与冒烟）
BACKEND=browser

# 打码（BACKEND=browser 时必填）
YES_KEY=your_yescaptcha_client_key_here
# YES_API=https://api.yescaptcha.com
# SOLVE_TIMEOUT=180

# 出口代理（可选，服务上一般填本机 clash/v2ray 端口）
# EGRESS_PROXY=http://127.0.0.1:7897

# 监听
# 默认只监听本机，由 Caddy/Nginx 反代对外；确需直连公网才改成 0.0.0.0
HOST=127.0.0.1
PORT=8888
# 管理员密钥：可看全部租户、可代租户发起请求、可预热。
# USERS 为空时它同时也是唯一入口密钥。必须设置：留空时所有接口返回 503，
# 仅本机调试可另设 ALLOW_NO_AUTH=1 关闭鉴权。
API_KEY=

# 多租户（可选）：用户:密钥:并发上限:排队上限
# 并发上限 = 在跑 + 在排队的总数，超出的请求直接拒绝（BUSY），不无界排队。
# 留空则退化为单租户：无 API_KEY -> public，有 API_KEY -> default。
# USERS=alice:key-alice-123:2:20, bob:key-bob-456:4:40
USERS=
# 换租户时是否整体换身份（新指纹+新 cookie）。false 只强制新导航，更快。
TENANT_ROTATE_IDENTITY=true

# 伸缩
# MAX_WORKERS 不设置时按本机 CPU 和空闲内存自动封顶（一个浏览器按 450MB，
# 至少给系统留 1.5GB）。显式写正数也不会超过这个容量。
MIN_WORKERS=1
# MAX_WORKERS=2
QUEUE_LIMIT=200
IDLE_TTL=300

# 身份轮换：一个身份服务多少次后重建
MAX_REQUESTS_PER_IDENTITY=50
BLOCK_STREAK_LIMIT=2

# 取答案
READY_QUIET=1.5
ANSWER_TIMEOUT=120
GOTO_TIMEOUT=45

# 浏览器与持久化目录
HEADLESS=true
# 留空用 playwright 自带 chromium；也可指定系统 chrome
CHROME_PATH=
STATE_DIR=./states
DATA_DIR=./data
BLOCK_ASSETS=true

# 统计与异步任务
TRUSTED_PROXIES=127.0.0.1,::1
METRICS_PREVIEW_CHARS=80
TASK_TTL=600

# Mock 后端与冒烟压测参数
MOCK_LATENCY=1.5-4.0
MOCK_FAIL_RATE=0.02
MOCK_ANSWER_CHARS=200-1200
MOCK_MAX_WORKERS=32
SOAK_MAX_CONCURRENCY=64

LOG_LEVEL=INFO
