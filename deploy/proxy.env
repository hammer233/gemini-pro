HOST=0.0.0.0
PORT=8080
YES_KEY=your_yescaptcha_client_key_here
CHROME_PATH=/usr/bin/google-chrome-stable
DATA_DIR=/var/lib/gemini-pro/data
STATE_DIR=/var/lib/gemini-pro/states
# 2 核 4GB 独占服务器：开启 Chrome 单渲染进程瘦身（~250MB/个）+ I/O 并发放大 + 350MB 动态内存背压保护
MIN_WORKERS=2
MAX_WORKERS=8
TENANT_ROTATE_IDENTITY=false
HEADLESS=true
BLOCK_ASSETS=true
ANSWER_TIMEOUT=90
GOTO_TIMEOUT=40
LOG_LEVEL=INFO
