HOST=127.0.0.1
PORT=8080
API_KEY=replace-with-a-long-random-string
YES_KEY=your_yescaptcha_client_key_here
CHROME_PATH=/usr/bin/google-chrome-stable
DATA_DIR=/var/lib/gemini-pro/data
STATE_DIR=/var/lib/gemini-pro/states
MIN_WORKERS=1
MAX_WORKERS=2
TENANT_ROTATE_IDENTITY=false
HEADLESS=true
BLOCK_ASSETS=true
ANSWER_TIMEOUT=90
GOTO_TIMEOUT=40
METRICS_PREVIEW_CHARS=0
TRUSTED_PROXIES=127.0.0.1,::1
LOG_LEVEL=INFO
